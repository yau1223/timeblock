# ===== 後端環境變數（Render 設定）=====

# PostgreSQL 連線字串（Render 會自動提供 DATABASE_URL，但需替換為 asyncpg 格式）
# 注意：Render 給的格式是 postgresql://，需改為 postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT 密鑰（必填，至少 32 字元隨機字串）
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars

# JWT 設定
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 前端 URL（CORS 白名單，Vercel 部署後的網址，逗號可分隔多個）
FRONTEND_URL=https://your-app.vercel.app

# 環境標識
ENVIRONMENT=production

# Google OAuth（選填）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth（選填）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== 前端環境變數（Vercel 設定）=====

# 後端 API 位址（Render 部署後的網址）
VITE_API_URL=https://your-backend.onrender.com
